{
  "name": "postnl-mcp",
  "version": "0.2.3",
  "packageManager": "pnpm@10.28.1",
  "description": "MCP server for the PostNL Shipping API — create shipments, generate barcodes, track parcels, and find pickup locations",
  "type": "module",
  "bin": {
    "postnl-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartwaardenburg/postnl-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "postnl",
    "shipping-api",
    "shipment-labels",
    "barcode",
    "parcel-tracking",
    "delivery-date",
    "pickup-locations",
    "logistics",
    "netherlands",
    "automation",
    "ai",
    "typescript",
    "nodejs"
  ],
  "author": "Bart Waardenburg",
  "license": "MIT",
  "mcpName": "io.github.BartWaardenburg/postnl-mcp",
  "bugs": {
    "url": "https://github.com/bartwaardenburg/postnl-mcp/issues"
  },
  "homepage": "https://github.com/bartwaardenburg/postnl-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": "^6.2.5"
    }
  }
}
